// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

model Space {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String         @db.VarChar(255)
  slug             String         @unique
  alias            String         @db.VarChar(20)
  description      String
  isPublic         Boolean        @default(false)
  resources        Resource[]
  learningPaths    LearningPath[]
  projects         Project[]
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contributions    Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Resource {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String         @db.VarChar(255)
  slug             String         @unique
  description      String
  spaceId          String         @db.Uuid
  space            Space          @relation(fields: [spaceId], references: [id])
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contributions    Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LearningPath {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String         @db.VarChar(255)
  description      String
  spaceId          String         @db.Uuid
  space            Space          @relation(fields: [spaceId], references: [id])
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contributions    Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Project {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String         @db.VarChar(255)
  description      String
  spaceId          String         @db.Uuid
  space            Space          @relation(fields: [spaceId], references: [id])
  clientId         String         @db.Uuid
  client           Client         @relation(fields: [clientId], references: [id])
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contributions    Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Profile {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bio    String?
  user   User    @relation(fields: [userId], references: [id])
  userId String  @unique @db.Uuid
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique
  name          String
  profile       Profile?
  spaces        Space[]
  resources     Resource[]
  learningPaths LearningPath[]
  clients       Client[]
  contributions Contribution[]
  projects      Project[]
  pointRules    PointRule[]
}

model Client {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String
  url              String?
  projects         Project[]
  lastModifiedById String    @db.Uuid
  lastModifiedBy   User      @relation(fields: [lastModifiedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Contribution {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contributorId  String        @db.Uuid
  contributor    User          @relation(fields: [contributorId], references: [id])
  spaceId        String        @db.Uuid
  space          Space         @relation(fields: [spaceId], references: [id])
  resourceId     String?       @db.Uuid
  resource       Resource?     @relation(fields: [resourceId], references: [id])
  learningPathId String?       @db.Uuid
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id])
  projectId      String?       @db.Uuid
  project        Project?      @relation(fields: [projectId], references: [id])
  pointRuleId    String        @db.Uuid
  pointRule      PointRule     @relation(fields: [pointRuleId], references: [id])
}

model PointRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectId         String         @db.Uuid
  object           Object         @relation(fields: [objectId], references: [id])
  actionId         String         @db.Uuid
  action           Action         @relation(fields: [actionId], references: [id])
  points           Int
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contribution     Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Object {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @unique
  pointRule PointRule[]
}

model Action {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  description String      @db.VarChar(25)
  pointRule   PointRule[]
}
