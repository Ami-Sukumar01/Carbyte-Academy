// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

model Space {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String         @unique @db.VarChar(255)
  alias                     String         @unique @db.VarChar(20)
  description               String
  isPublic                  Boolean        @default(false)
  resources                 Resource[]
  learningPaths             LearningPath[]
  projects                  Project[]
  lastModifiedById          String         @db.Uuid
  lastModifiedBy            User           @relation(fields: [lastModifiedById], references: [id])
  contributions             Contribution[]
  fundamentalLearningPathId String?        @unique @db.Uuid
  fundamentalLearningPath   LearningPath?  @relation("FundamentalLearningPath", fields: [fundamentalLearningPathId], references: [id])
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
}

model Resource {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String            @unique @db.VarChar(255)
  description      String
  url              String            @unique @db.VarChar(2083) //Stores a unique resource URL
  audienceId       String            @db.Uuid
  audience         Audience          @relation(fields: [audienceId], references: [id])
  isOutdated       Boolean           @default(false)
  isPrivat         Boolean           @default(false) // Default to false, meaning public. Change to isPublic
  spaceId          String            @db.Uuid
  space            Space             @relation(fields: [spaceId], references: [id])
  lastModifiedById String            @db.Uuid
  lastModifiedBy   User              @relation(fields: [lastModifiedById], references: [id])
  resourceTypeId   String            @db.Uuid
  resourceType     ResourceType      @relation(fields: [resourceTypeId], references: [id])
  upvotes          ResourceUpvote[]
  views            ResourceView[]
  contributions    Contribution[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  comments         Comment[]
  resourceSections ResourceSection[]
}

model Audience {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String         @unique @db.VarChar(255)
  description      String?
  resources        Resource[]
  learningPaths    LearningPath[]
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LearningPath {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String               @unique @db.VarChar(255)
  description      String
  spaceId          String               @db.Uuid
  space            Space                @relation(fields: [spaceId], references: [id])
  lastModifiedById String               @db.Uuid
  lastModifiedBy   User                 @relation(fields: [lastModifiedById], references: [id])
  audienceId       String               @db.Uuid //Audience
  audience         Audience             @relation(fields: [audienceId], references: [id])
  isPublic         Boolean              @default(false) //Public
  estimatedTime    Int //Time to complete a LearningPath stored in minutes
  upvotes          LearningPathUpvote[] //Upvotes
  views            LearningPathView[] //Views
  contributions    Contribution[]
  comments         Comment[]
  sections         Section[]
  spaceFundamental Space?               @relation("FundamentalLearningPath")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Project {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String         @unique @db.VarChar(255)
  description      String
  spaceId          String         @db.Uuid
  space            Space          @relation(fields: [spaceId], references: [id])
  clientId         String         @db.Uuid
  client           Client         @relation(fields: [clientId], references: [id])
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contributions    Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Profile {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bio       String? @db.VarChar(255)
  avatarUrl String? @db.VarChar(2083)
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @unique @db.Uuid
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.VarChar(255)
  name                String
  profile             Profile?
  spaces              Space[]
  resources           Resource[]
  learningPaths       LearningPath[]
  clients             Client[]
  contributions       Contribution[]
  projects            Project[]
  pointRules          PointRule[]
  resourceViews       ResourceView[]
  resourceUpvotes     ResourceUpvote[]
  comments            Comment[]
  commentUpvotes      CommentUpvote[]
  audiences           Audience[]
  learningPathUpvotes LearningPathUpvote[]
  learningPathViews   LearningPathView[]
  resourceSections    ResourceSection[]
  sections            Section[]
}

model Client {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @unique @db.VarChar(255)
  description      String
  url              String?   @unique @db.VarChar(2083)
  projects         Project[]
  lastModifiedById String    @db.Uuid
  lastModifiedBy   User      @relation(fields: [lastModifiedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Contribution {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contributorId  String        @db.Uuid
  contributor    User          @relation(fields: [contributorId], references: [id])
  spaceId        String        @db.Uuid
  space          Space         @relation(fields: [spaceId], references: [id])
  resourceId     String?       @db.Uuid
  resource       Resource?     @relation(fields: [resourceId], references: [id])
  learningPathId String?       @db.Uuid
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id])
  projectId      String?       @db.Uuid
  project        Project?      @relation(fields: [projectId], references: [id])
  pointRuleId    String        @db.Uuid
  pointRule      PointRule     @relation(fields: [pointRuleId], references: [id])
  createdAt      DateTime      @default(now())
}

model PointRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectId         String         @db.Uuid
  object           Object         @relation(fields: [objectId], references: [id])
  actionId         String         @db.Uuid
  action           Action         @relation(fields: [actionId], references: [id])
  points           Int
  lastModifiedById String         @db.Uuid
  lastModifiedBy   User           @relation(fields: [lastModifiedById], references: [id])
  contribution     Contribution[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Object {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @unique @db.VarChar(255)
  pointRule PointRule[]
}

model Action {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique @db.VarChar(32)
  description String      @db.VarChar(32)
  pointRule   PointRule[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ResourceType {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(255)
  description String?
  resources   Resource[]
}

model ResourceUpvote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id])
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId]) // Ensures a user can upvote a resource only once
}

model ResourceView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id])
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId]) //Ensures a user can view a resource only once
}

model Comment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content        String          @db.VarChar(255)
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  resourceId     String?         @db.Uuid
  resource       Resource?       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  learningPathId String?         @db.Uuid
  learningPath   LearningPath?   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  parentId       String?         @db.Uuid
  parent         Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade) // Allows to comment on available comments (Tree structure)
  replies        Comment[]       @relation("CommentReplies")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  commentUpvotes CommentUpvote[]
}

model CommentUpvote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, commentId]) //Ensures a user can upvote a comment once
}

model Section {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String            @db.VarChar(255)
  description      String            @db.VarChar(255)
  learningPathId   String            @db.Uuid
  learningPath     LearningPath      @relation(fields: [learningPathId], references: [id])
  resourceSections ResourceSection[]
  parentId         String?           @db.Uuid
  parent           Section?          @relation("Subsections", fields: [parentId], references: [id])
  lastModifiedById String            @db.Uuid
  lastModifiedBy   User              @relation(fields: [lastModifiedById], references: [id])
  subsections      Section[]         @relation("Subsections")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ResourceSection {
  resourceId       String   @db.Uuid
  resource         Resource @relation(fields: [resourceId], references: [id])
  sectionId        String   @db.Uuid
  section          Section  @relation(fields: [sectionId], references: [id])
  lastModifiedById String   @db.Uuid
  lastModifiedBy   User     @relation(fields: [lastModifiedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([resourceId, sectionId])
}

model LearningPathUpvote {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learningPathId String       @db.Uuid
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id])
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
}

model LearningPathView {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learningPathId String       @db.Uuid
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id])
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
}
